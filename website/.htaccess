# niyetsen.com — HTTPS + www birleştirme + akıllı önbellek
RewriteEngine On

# HTTP → HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www → kök domain (canonical: niyetsen.com)
RewriteCond %{HTTP_HOST} ^www\.niyetsen\.com$ [NC]
RewriteRule ^ https://niyetsen.com%{REQUEST_URI} [L,R=301]

# Dizin isteklerinde index.html
DirectoryIndex index.html

<IfModule mod_headers.c>
  # HTML: tarayıcı eski sayfayı tutmasın (Google tıklaması dahil)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Statik varlıklar: uzun önbellek (sürüm query ?v= ile kırılır)
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico|woff2|woff|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
