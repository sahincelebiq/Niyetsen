# Niyetsen — örnek ortam değişkenleri
# Bu dosyayı .env olarak kopyala; GERÇEK değerleri ORADA doldur. .env asla commit edilmez.

ENV=dev
AUTH_DISABLED=true          # prod'da false ZORUNLU (main.py kilidi var)

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PLAN=gemini-2.5-pro
GEMINI_CHAT_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SEC=30
GEMINI_PLAN_TIMEOUT_SEC=90
GEMINI_PROOF_TIMEOUT_SEC=45
GEMINI_MAX_RETRIES=3

GEMINI_PROOF_TIMEOUT_SEC=45
GEMINI_MAX_RETRIES=3

# Nano Banana (Gemini 2.5 Flash Image) — plan görselleri; Unsplash ana kaynak, hibrit
GEMINI_MODEL_IMAGE=gemini-2.5-flash-image
GEMINI_IMAGE_TIMEOUT_SEC=60
IMAGE_GEMINI_ENABLED=true
IMAGE_GEMINI_RATIO=0.5

# Görsel (boş bırakılırsa dev'de yer tutucu görsel kullanılır)
UNSPLASH_ACCESS_KEY=
# Opsiyonel; kodda henüz kullanılmıyor ama saklanabilir
UNSPLASH_SECRET_KEY=

# v1 — Supabase (Auth + DB + Storage)
SUPABASE_URL=
# JWT doğrulama JWKS üzerinden yapılır (SUPABASE_URL/auth/v1/.well-known/jwks.json)
# — ayrı bir secret gerekmez.
# Project Settings > API > service_role anahtarı — ASLA mobile'a/client'a sızma
SUPABASE_SERVICE_KEY=
# Yeni Supabase dashboard adı (cron/api ikisinde de kabul edilir)
SUPABASE_SECRET_KEY=
# true yapınca SupabaseRepository devreye girer (InMemory yerine gerçek DB)
USE_SUPABASE_DB=false
# Postgres pooler (transaction 6543 / session 5432) — Dashboard → Database password
# SUPABASE_SERVICE_KEY postgres şifresi değildir. Özel karakterleri URL-encode et.
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql://postgres.ktweahgrrppmxpdhohdh:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.ktweahgrrppmxpdhohdh:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# Railway/Render cron isteğinin X-Cron-Secret başlığı (güçlü rastgele değer)
CRON_SECRET=
# Tarayıcı istemcileri için virgülle ayrılmış tam origin'ler (prod'da gerekli).
# Fiziksel Expo cihazı CORS kullanmaz; local web örneği:
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# Plan üretim ayarları
PLAN_BATCH_DAYS=7
MAX_TASKS_PER_DAY=5
CHAT_RATE_LIMIT_PER_MIN=10
PROOF_RATE_LIMIT_PER_MIN=12

SUPABASE_TIMEOUT_SEC=120

# Railway cron: direct = Supabase'e doğrudan (önerilen), http = API'ye POST
CRON_EXECUTION_MODE=direct
CRON_SKIP_PUSH=true
# Railway dashboard → Project Settings → General
RAILWAY_PROJECT_ID=
# Project Settings → Tokens → Project Access Token (scriptler: verify_cron_config, redeploy)
RAILWAY_PROJECT_TOKEN=
PLAN_RATE_LIMIT_PER_MIN=3

# Hukuki metin sürümleri — yayımlanan metin değiştiğinde ilgili sürümü artır.
PRIVACY_POLICY_VERSION=2026-07-11
KVKK_CONSENT_VERSION=2026-07-11
AI_CHAT_CONSENT_VERSION=2026-07-11
PROOF_PHOTO_CONSENT_VERSION=2026-07-11
MARKETING_CONSENT_VERSION=2026-07-11
LEGAL_DATA_CONTROLLER=Şahin Çelebi
LEGAL_CONTACT_EMAIL=ai@niyetsen.com

# RevenueCat webhook doğrulaması (Authorization: Bearer <secret>)
REVENUECAT_WEBHOOK_SECRET=
# Secret API key — satın alma sonrası /me/subscription/sync için (dashboard)
REVENUECAT_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium

# Opsiyonel hata izleme (sentry-sdk kuruluysa devreye girer)
SENTRY_DSN=

# Stripe — v1 mobil IAP için KULLANILMAZ (RevenueCat). İleride web/B2B için:
# Gerçek değerler: .env.stripe.local (gitignore'da)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=

# --- V2: RAG + Fal modülü (FAZ 7) ---
# RAG varsayılan açık; embedding kapatılırsa keyword fallback çalışır.
RAG_ENABLED=true
RAG_EMBEDDINGS_ENABLED=true
RAG_TOP_K=4
GEMINI_EMBED_MODEL=gemini-embedding-001
FORTUNE_RATE_LIMIT_PER_MIN=6

# Geliştirici hesapları (virgülle ayrılmış e-posta) — mağaza satın alması
# olmadan tam erişim. Yalnız kendi hesabını yaz; boş bırakılırsa koddaki
# varsayılan (kutluadalarr7@gmail.com) geçerli.
DEV_ACCOUNT_EMAILS=kutluadalarr7@gmail.com
